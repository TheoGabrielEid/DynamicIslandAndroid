<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/expanded_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_island_expanded"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Main Unified Glassmorphic Media Card (Exact PC M3 Style) -->
    <LinearLayout
        android:id="@+id/media_main_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_media_main_card"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="12dp">

        <!-- Row 1: Album Art + Track Metadata & Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/expanded_art"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_album_art"
                android:contentDescription="Album Art"
                android:padding="12dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_music"
                app:tint="@color/m3_primary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/expanded_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="18dp"
                        android:background="@drawable/bg_app_badge"
                        android:gravity="center"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:text="● IDLE"
                        android:textColor="@color/m3_muted"
                        android:textSize="9sp"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/btn_collapse"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_pill_button"
                        android:contentDescription="Collapse"
                        android:padding="6dp"
                        android:src="@drawable/ic_close"
                        app:tint="@color/m3_on_surface_var" />
                </LinearLayout>

                <TextView
                    android:id="@+id/expanded_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:ellipsize="marquee"
                    android:focusable="true"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:text="Nothing playing"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/expanded_artist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="Play music on Spotify, YouTube or Chrome"
                    android:textColor="@color/m3_on_surface_var"
                    android:textSize="12sp" />
            </LinearLayout>

        </LinearLayout>

        <!-- Row 2: Squiggly Wavy Scrubber Bar & Timestamps -->
        <com.dynamicisland.app.view.WavyProgressBar
            android:id="@+id/expanded_wavy_progress"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="8dp" />

        <!-- Row 3: Hero Transport Controls + Frosted Volume Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="4dp">

            <!-- Transport Cluster -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btn_prev"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_pill_button"
                    android:contentDescription="Previous"
                    android:padding="8dp"
                    android:src="@drawable/ic_prev"
                    app:tint="@color/m3_on_surface" />

                <ImageButton
                    android:id="@+id/btn_play_pause"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_play_btn"
                    android:contentDescription="Play or Pause"
                    android:padding="10dp"
                    android:src="@drawable/ic_play"
                    app:tint="@color/m3_on_primary" />

                <ImageButton
                    android:id="@+id/btn_next"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_pill_button"
                    android:contentDescription="Next"
                    android:padding="8dp"
                    android:src="@drawable/ic_next"
                    app:tint="@color/m3_on_surface" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Sleek Frosted Volume Pill (Exact PC Style) -->
            <LinearLayout
                android:id="@+id/vol_pill"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_volume_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="10dp">

                <ImageButton
                    android:id="@+id/btn_vol_icon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="Volume"
                    android:src="@drawable/ic_volume"
                    app:tint="@color/m3_on_surface_var" />

                <SeekBar
                    android:id="@+id/slider_volume"
                    android:layout_width="86dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:max="100"
                    android:progress="70"
                    android:progressDrawable="@drawable/volume_progress"
                    android:splitTrack="false"
                    android:thumb="@drawable/volume_thumb" />

                <TextView
                    android:id="@+id/tv_volume_lbl"
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="70%"
                    android:textColor="@color/m3_on_surface_var"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
