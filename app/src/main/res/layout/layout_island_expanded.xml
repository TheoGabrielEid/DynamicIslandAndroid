<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/expanded_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_island_expanded"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top Row: Album Cover + Title / Artist & Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/expanded_art"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:contentDescription="Album Art"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_media_play"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/expanded_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_button"
                android:paddingStart="8dp"
                android:paddingTop="2dp"
                android:paddingEnd="8dp"
                android:paddingBottom="2dp"
                android:text="● PLAYING"
                android:textColor="@color/island_primary"
                android:textSize="9sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/expanded_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="marquee"
                android:focusable="true"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:text="Nothing playing"
                android:textColor="@color/island_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/expanded_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:text="Play music on your phone"
                android:textColor="@color/island_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_collapse"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_pill_button"
            android:contentDescription="Collapse"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/white" />

    </LinearLayout>

    <!-- Middle: Squiggly Wavy Progress Bar -->
    <com.dynamicisland.app.view.WavyProgressBar
        android:id="@+id/expanded_wavy_progress"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="10dp" />

    <!-- Bottom: Hero Transport Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingTop="6dp">

        <ImageButton
            android:id="@+id/btn_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_pill_button"
            android:contentDescription="Previous"
            android:src="@android:drawable/ic_media_previous"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/btn_play_pause"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/bg_pill_button"
            android:contentDescription="Play or Pause"
            android:src="@android:drawable/ic_media_play"
            app:tint="@color/white" />

        <ImageButton
            android:id="@+id/btn_next"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_pill_button"
            android:contentDescription="Next"
            android:src="@android:drawable/ic_media_next"
            app:tint="@color/white" />

    </LinearLayout>

</LinearLayout>
