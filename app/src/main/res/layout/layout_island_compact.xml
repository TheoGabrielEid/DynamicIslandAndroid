<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/compact_container"
    android:layout_width="wrap_content"
    android:layout_height="38dp"
    android:background="@drawable/bg_island_compact"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <ImageView
        android:id="@+id/compact_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="Mini Art"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_music" />

    <TextView
        android:id="@+id/compact_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="marquee"
        android:focusable="true"
        android:marqueeRepeatLimit="marquee_forever"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:singleLine="true"
        android:text="Dynamic Island"
        android:textColor="@color/island_text_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/compact_trailing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="●"
        android:textColor="@color/island_primary"
        android:textSize="10sp" />

</LinearLayout>
