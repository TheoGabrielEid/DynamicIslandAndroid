<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/compact_container"
    android:layout_width="wrap_content"
    android:layout_height="38dp"
    android:background="@drawable/bg_island_compact"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="7dp"
    android:paddingEnd="10dp">

    <!-- Left Badge (PC CompactView Badge) -->
    <FrameLayout
        android:id="@+id/compact_badge_container"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="@drawable/bg_compact_badge">

        <ImageView
            android:id="@+id/compact_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:contentDescription="Mini Art"
            android:scaleType="centerInside"
            android:src="@drawable/ic_music"
            app:tint="@color/m3_on_primary" />
    </FrameLayout>

    <!-- Center Track Title -->
    <TextView
        android:id="@+id/compact_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="marquee"
        android:focusable="true"
        android:marqueeRepeatLimit="marquee_forever"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:singleLine="true"
        android:text="Dynamic Island"
        android:textColor="@color/m3_on_surface"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <!-- Right Indicator: Waveform bars / status dot -->
    <TextView
        android:id="@+id/compact_trailing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.1"
        android:text="  ılı"
        android:textColor="@color/m3_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
