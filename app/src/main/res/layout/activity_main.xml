<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Hero Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_compact_badge">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="Logo"
                    android:src="@drawable/ic_music"
                    app:tint="@color/m3_on_primary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dynamic Island Pro"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Material 3 Expressive · Media · LAN/WAN Graph · Focus"
                    android:textColor="@color/m3_on_surface_var"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Master Enable Switch Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="#14FFFFFF"
            app:cardCornerRadius="22dp"
            app:strokeColor="#28FFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/enable_service"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_service_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/service_stopped"
                        android:textColor="@color/m3_on_surface_var"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_service"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Permissions Section Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.08"
            android:text="REQUIRED PERMISSIONS"
            android:textColor="@color/m3_primary"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <!-- Permission 1: Overlay -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="#0DFFFFFF"
            app:cardCornerRadius="18dp"
            app:strokeColor="#1FFFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="15dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_overlay_title"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/permission_overlay_desc"
                        android:textColor="@color/m3_on_surface_var"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_perm_overlay"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/grant_permission" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Permission 2: Notifications / Media -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="#0DFFFFFF"
            app:cardCornerRadius="18dp"
            app:strokeColor="#1FFFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="15dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/permission_notification_title"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/permission_notification_desc"
                        android:textColor="@color/m3_on_surface_var"
                        android:textSize="11sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_perm_notification"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/grant_permission" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Accent Color Theme Picker (12 Themes in 3x4 Grid) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.08"
            android:text="ACCENT COLOR THEMES (12 PRESETS)"
            android:textColor="@color/m3_primary"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="#0DFFFFFF"
            app:cardCornerRadius="18dp"
            app:strokeColor="#1FFFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Row 1 of Themes -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/theme_periwinkle"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tab_selected"
                        android:gravity="center"
                        android:text="● Sky Blue"
                        android:textColor="#A8C7FA"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/theme_emerald"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tab_unselected"
                        android:gravity="center"
                        android:text="● Emerald"
                        android:textColor="#7FD88F"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/theme_violet"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tab_unselected"
                        android:gravity="center"
                        android:text="● Violet"
                        android:textColor="#D0BCFF"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/theme_sunset"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tab_unselected"
                        android:gravity="center"
                        android:text="● Gold"
                        android:textColor="#FFB86C"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 2 of Themes -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/theme_crimson"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tab_unselected"
                        android:gravity="center"
                        android:text="● Crimson"
                        android:textColor="#FFB4AB"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/theme_cyan"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tab_unselected"
                        android:gravity="center"
                        android:text="● Cyber"
                        android:textColor="#70F0FF"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/theme_lavender"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tab_unselected"
                        android:gravity="center"
                        android:text="● Sakura"
                        android:textColor="#E7B9F5"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/theme_lime"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tab_unselected"
                        android:gravity="center"
                        android:text="● Matrix"
                        android:textColor="#9BD84A"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Row 3 of Themes -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/theme_magenta"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tab_unselected"
                        android:gravity="center"
                        android:text="● Magenta"
                        android:textColor="#FF79C6"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/theme_indigo"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tab_unselected"
                        android:gravity="center"
                        android:text="● Indigo"
                        android:textColor="#818CF8"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/theme_aqua"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tab_unselected"
                        android:gravity="center"
                        android:text="● Mint"
                        android:textColor="#2DD4BF"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/theme_silver"
                        android:layout_width="0dp"
                        android:layout_height="34dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tab_unselected"
                        android:gravity="center"
                        android:text="● Frost"
                        android:textColor="#E2E8F0"
                        android:textSize="10.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Smart Features & Gestures -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.08"
            android:text="SMART FEATURES &amp; NETWORK TELEMETRY"
            android:textColor="@color/m3_primary"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="#0DFFFFFF"
            app:cardCornerRadius="18dp"
            app:strokeColor="#1FFFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_start_on_boot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Auto-Start Dynamic Island on Phone Boot"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="13sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_wan_vpn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Color WAN IP Green when VPN Active (Red when Off)"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="13sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_idle_clock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Show Live Clock &amp; Battery % when Idle"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="13sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_auto_expand"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Show Song Toast &amp; Aura Glow on Track Change"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="13sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_double_tap"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Double-Tap Pill to Play / Pause Music"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="13sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_long_press"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Long-Press Pill to Toggle Flashlight"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="13sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_maps_nav"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Google Maps Turn-by-Turn Island Directions"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="13sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch_headset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Headphones &amp; Earbuds Connect Alerts"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Notch & Island Geometry Calibration -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.08"
            android:text="CAMERA CUTOUT &amp; SIZE CALIBRATION"
            android:textColor="@color/m3_primary"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="#0DFFFFFF"
            app:cardCornerRadius="18dp"
            app:strokeColor="#1FFFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/lbl_notch_x"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Horizontal Offset (X): 0 dp"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="13sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_notch_x"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:value="0"
                    android:valueFrom="-140"
                    android:valueTo="140" />

                <TextView
                    android:id="@+id/lbl_notch_y"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Top Margin (Y): 8 dp"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="13sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_notch_y"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:value="8"
                    android:valueFrom="0"
                    android:valueTo="60" />

                <TextView
                    android:id="@+id/lbl_island_w"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Compact Pill Width: 170 dp"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="13sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_island_w"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="2"
                    android:value="170"
                    android:valueFrom="110"
                    android:valueTo="260" />

                <TextView
                    android:id="@+id/lbl_island_h"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Compact Pill Height: 36 dp"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="13sp" />

                <com.google.android.material.slider.Slider
                    android:id="@+id/slider_island_h"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:stepSize="1"
                    android:value="36"
                    android:valueFrom="28"
                    android:valueTo="52" />

                <Button
                    android:id="@+id/btn_reset_pos"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="↺ Reset Position Defaults"
                    android:textColor="@color/m3_primary" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Test & Simulation Deck -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="36dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_test_island"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:text="♫ Test Music" />

            <Button
                android:id="@+id/btn_test_charging"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="⚡ Test Charging" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
